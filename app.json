{
  "expo": {
    "name": "EventEase2",
    "slug": "EventEase2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/assets/Logo_Original.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/assets/Logo_Original.png",
        "backgroundImage": "./src/assets/assets/Logo_Original.png",
        "monochromeImage": "./src/assets/assets/Logo_Original.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/assets/Logo_Original.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-font",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ]
  }
}
